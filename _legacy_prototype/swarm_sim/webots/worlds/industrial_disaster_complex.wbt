WorldInfo {
  info [
    "36m x 28m Multi-Building Industrial & Office Disaster Complex"
    "2 Specialized Autonomous UGVs (UGV-1 Alpha-SAR & UGV-2 Beta-Hazmat)"
    "Uses C:/Users/mange/anaconda3/envs/pytorch/python.exe via runtime.ini"
  ]
  title "MUM-T 6-Building Industrial Complex — 2-UGV Decentralized Swarm"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.56 0.56 0.61 1.92
  position 18.0 -16.0 29.5
}

TexturedBackground {
  texture "noon_cloudy_countryside"
  skybox TRUE
}

TexturedBackgroundLight {
  texture "noon_cloudy_countryside"
  castShadows TRUE
}

RectangleArena {
  translation 18 14 0
  floorSize 36 28
  floorTileSize 2 2
  wallHeight 2.2
}

