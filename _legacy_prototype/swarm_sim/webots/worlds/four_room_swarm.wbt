#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "Decentralized MUM-T / Loyal Wingman 4-Room Swarm Simulation"
    "Uses C:/Users/mange/anaconda3/envs/pytorch/python.exe via runtime.ini"
  ]
  title "CoopAI 3D Four-Room Swarm Arena"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.55 0.58 0.60 1.95
  position 5.0 -7.5 11.5
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  translation 5 5 0
  floorSize 10 10
  floorTileSize 1 1
  wallHeight 1.0
}

# Room 1 (Fire Hazard Target)
Solid {
  translation 2.0 1.4 0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.96 0.28 0.08
        emissiveColor 0.8 0.2 0.05
      }
      geometry Cone {
        bottomRadius 0.32
        height 0.8
      }
    }
  ]
  name "room_1_fire_target"
}

# Room 2 (Gas Hazard Target)
Solid {
  translation 8.0 1.4 0.4
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.58 0.92 0.14
        emissiveColor 0.35 0.65 0.08
      }
      geometry Cylinder {
        radius 0.28
        height 0.75
      }
    }
  ]
  name "room_2_gas_target"
}

# Room 3 (Trapped Person Target)
Solid {
  translation 2.0 8.6 0.45
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.92 0.24 0.78
      }
      geometry Cylinder {
        radius 0.22
        height 0.9
      }
    }
  ]
  name "room_3_person_target"
}

# Room 4 (Routine Inspection Target)
Solid {
  translation 8.0 8.6 0.35
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.78 0.52
      }
      geometry Box {
        size 0.45 0.45 0.45
      }
    }
  ]
  name "room_4_clear_target"
}

# Autonomous Swarm Supervisor & Physics Bridge Robot
Robot {
  translation 5 5 0.2
  supervisor TRUE
  controller "swarm_unit_controller"
  name "SwarmArenaSupervisor"
}
